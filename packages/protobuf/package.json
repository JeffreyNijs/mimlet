{
  "name": "@mimlet/protobuf",
  "version": "0.1.0-beta.7",
  "private": false,
  "description": "Lossless native Protobuf fixture generation, verification and binary codecs with offline schema resolution.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/mimlet.git",
    "directory": "packages/protobuf"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "pnpm type-check",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --root ../.. --project unit tests/unit/mimlet-protobuf.test.ts"
  },
  "dependencies": {
    "@mimlet/core": "0.1.0-beta.7",
    "protobufjs": "8.8.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "bugs": {
    "url": "https://github.com/JeffreyNijs/mimlet/issues"
  },
  "homepage": "https://jeffreynijs.github.io/mimlet/packages/protobuf",
  "keywords": [
    "test-data",
    "fixtures",
    "builders",
    "standard-schema"
  ]
}
