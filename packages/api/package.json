{
  "name": "@mimlet/api",
  "version": "0.1.0-beta.1",
  "private": false,
  "description": "Offline OpenAPI operation fixtures with direction-aware schemas and explicit HTTP serialization.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/mimlet.git",
    "directory": "packages/api"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "pnpm type-check",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --root ../.. --project unit tests/unit/mimlet-api.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "bugs": {
    "url": "https://github.com/JeffreyNijs/mimlet/issues"
  },
  "homepage": "https://jeffreynijs.github.io/mimlet/packages/api",
  "keywords": [
    "test-data",
    "fixtures",
    "builders",
    "standard-schema"
  ],
  "dependencies": {
    "@mimlet/core": "0.1.0-beta.1",
    "@mimlet/json-schema": "0.1.0-beta.1"
  }
}
