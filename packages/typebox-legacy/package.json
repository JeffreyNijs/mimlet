{
  "name": "@mimlet/typebox-legacy",
  "version": "0.1.0-beta.1",
  "private": false,
  "description": "Native @sinclair/typebox fixtures, strict validation and codecs for Mimlet.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@sinclair/typebox": ">=0.34.48 <=0.34.52"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/mimlet.git",
    "directory": "packages/typebox-legacy"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "pnpm type-check",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --root ../.. --project unit tests/unit/mimlet-typebox-legacy.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "bugs": {
    "url": "https://github.com/JeffreyNijs/mimlet/issues"
  },
  "homepage": "https://jeffreynijs.github.io/mimlet/packages/typebox-legacy",
  "keywords": [
    "test-data",
    "fixtures",
    "builders",
    "standard-schema"
  ],
  "devDependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "dependencies": {
    "@mimlet/core": "0.1.0-beta.1"
  }
}
