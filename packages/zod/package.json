{
  "name": "@mimlet/zod",
  "version": "0.1.0-beta.4",
  "private": false,
  "description": "Native Zod fixture builders with typed factories and input/output semantics.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "zod": ">=4.3.0 <5"
  },
  "mimlet": {
    "testedPeers": {
      "zod": ">=4.3.0 <=4.6.5"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/mimlet.git",
    "directory": "packages/zod"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "pnpm type-check",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --root ../.. --project unit tests/unit/mimlet-zod.test.ts tests/unit/mimlet-zod-generated.test.ts"
  },
  "dependencies": {
    "@mimlet/core": "0.1.0-beta.4",
    "@mimlet/json-schema": "0.1.0-beta.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "bugs": {
    "url": "https://github.com/JeffreyNijs/mimlet/issues"
  },
  "homepage": "https://jeffreynijs.github.io/mimlet/packages/zod",
  "keywords": [
    "test-data",
    "fixtures",
    "builders",
    "standard-schema"
  ],
  "devDependencies": {
    "zod": "4.4.3"
  }
}
