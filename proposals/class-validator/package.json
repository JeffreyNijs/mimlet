  },
  "devDependencies": {
    "@nestjs/common": "11.1.24",
    "@types/node": "22.20.5",
    "@types/qs": "6.15.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "qs": "6.16.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
