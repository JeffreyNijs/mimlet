{
  "name": "mimlet-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Modular schema-independent test-data toolkit and integrations.",
  "type": "module",
  "license": "MIT",
  "author": "JeffreyNijs",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "0.28.1",
      "flatted": "3.4.4",
      "nanoid@3": "3.3.18",
      "picomatch": "4.0.5",
      "postcss": "8.5.26",
      "rollup": "4.62.4",
      "vite@7": "7.3.5",
      "js-yaml@4": "4.3.2",
      "vitepress>vite": "6.4.3",
      "brace-expansion@5": "5.0.12",
      "source-map-js": "1.2.2"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.5.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@resvg/resvg-js": "2.6.2",
    "@sinclair/typebox": "0.34.52",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/coverage-v8": "4.1.10",
    "arktype": "2.2.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "effect": "4.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "fast-check": "4.10.2",
    "hey-api-builders": "workspace:*",
    "@mimlet/core": "workspace:*",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "tsup": "8.5.1",
    "turbo": "2.11.7",
    "typebox": "1.3.34",
    "typescript": "6.0.3",
    "valibot": "1.5.0",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "scripts": {
    "preinstall": "node scripts/check-workspace.mjs",
    "build": "turbo run build",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "watch": "pnpm --filter hey-api-builders watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "pnpm type-check",
    "test": "pnpm test:unit && pnpm test:core && pnpm test:integration && pnpm test:typebox && pnpm test:optional",
    "test:core": "tsc -p packages/core/tsconfig.json && tsc -p packages/core/test/tsconfig.json && node scripts/test-core.mjs",
    "test:watch": "vitest --watch --project unit",
    "test:coverage": "pnpm test:unit && pnpm test:core && vitest run --project integration --coverage && pnpm test:typebox && pnpm test:optional",
    "test:typebox": "node scripts/test-typebox.mjs",
    "test:optional": "node scripts/test-optional-all.mjs",
    "test:vendors": "node scripts/test-vendor-versions.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:package": "node scripts/validate-package.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check": "pnpm check:workspace && pnpm check:docs && pnpm build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:tooling && pnpm test:coverage",
    "validate": "pnpm check && pnpm test:package",
    "pack:check": "node scripts/pack-workspace.mjs --check",
    "release:prepare": "node scripts/pack-workspace.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-runtime-versions.mjs",
    "test:runtimes": "node scripts/test-runtimes.mjs",
    "test:examples": "node scripts/test-examples.mjs",
    "benchmark": "node scripts/benchmark.ts",
    "check:docs": "node scripts/check-documentation.ts",
    "type-check": "turbo run type-check && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "audit:production": "node scripts/audit-production.ts",
    "brand:render": "node scripts/render-brand.ts",
    "video": "node scripts/video/render.ts",
    "video:verify": "node scripts/video/verify.ts",
    "docs:dev": "pnpm --dir apps/docs docs:dev",
    "docs:build": "pnpm --dir apps/docs docs:build",
    "docs:preview": "pnpm --dir apps/docs docs:preview",
    "docs:test": "pnpm --dir apps/docs test"
  }
}
